# Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications
BOT_TOKEN=

# Application (Client) ID (REQUIRED)
# Found on your application's General Information page
CLIENT_ID=

# Your Discord User ID (REQUIRED)
# Enable Developer Mode in Discord settings, then right-click your profile -> Copy ID
BOT_OWNER_ID=

# Guild ID for testing (OPTIONAL)
# When set, commands are registered to this guild only (instant updates)
# Leave empty for global registration (can take up to 1 hour to propagate)
GUILD_ID=

# ========================================
# MUSIC SETTINGS (all optional)
# ========================================

# Spotify API Credentials (OPTIONAL - only needed if you specifically use play-dl or distube Spotify plugin)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify Market (OPTIONAL - defaults to US)
# Set to your country code for better regional results
SPOTIFY_MARKET=US


# Idle timeout in seconds before bot leaves voice channel (0 = disabled)
# Bot leaves after this many seconds of no music
IDLE_TIMEOUT=60

# Maximum songs per user in queue (0 = unlimited)
MAX_QUEUE_SIZE=100

# Maximum song duration in seconds (0 = unlimited)
MAX_DURATION=0

# Vote skip ratio (0.0-1.0)
SKIP_RATIO=0.5

# Stay in voice channel even when queue ends (24/7 mode, true/false)
STAY_IN_CHANNEL=false

# ========================================
# BOT PRESENCE SETTINGS (optional)
# ========================================
# Activity type: PLAYING, LISTENING, WATCHING, COMPETING, STREAMING
ACTIVITY_TYPE=LISTENING

# Activity name (what the bot is "listening to", "playing", etc.)
ACTIVITY_NAME=music | /help

# Streaming URL (REQUIRED if ACTIVITY_TYPE is STREAMING)
# Must be a Twitch or YouTube URL for the purple "Live" badge to appear
STREAMING_URL=

# Bot status: online, idle, dnd, invisible
BOT_STATUS=online

# Show current song in bot status (true/false)
SONG_IN_STATUS=true

# ========================================
# YOUTUBE SETTINGS (optional)
# ========================================

# YouTube Cookies (OPTIONAL - for age-restricted or region-locked videos)
# Export cookies from your browser in Netscape/Mozilla format using a browser extension
# Save as youtube-cookies.txt (or cookies.txt) in the project root
# The bot picks it up automatically on startup

# ========================================
# ADVANCED / ENGINE SETTINGS (optional)
# ========================================

# Custom yt-dlp Path (OPTIONAL)
# If you are using a Python venv for yt-dlp, point this to the binary.
# Windows: ./venv/Scripts/yt-dlp.exe
# Linux: ./venv/bin/yt-dlp
# YTDLP_PATH=./venv/Scripts/yt-dlp.exe

# Custom ffmpeg Path (OPTIONAL)
# Provide a specific path to ffmpeg executable if it's not in your system PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# ========================================
# HARDWARE OPTIMIZATION (optional)
# ========================================

# Disk Type (auto/hdd/ssd/nvme)
# SSDs/NVMes use smaller stream buffers (saves RAM), HDDs use larger ones to prevent head thrashing
SYSTEM_DISK_TYPE=auto

# FFmpeg Threads (auto/1/2/3/4...)
# Discord audio maxes out efficiency at 1-2 threads. Auto adapts based on your CPU cores.
FFMPEG_THREADS=auto

# Custom Stream Buffer Size in MB (optional)
# Overrides the disk type automatic calculation. (e.g. 16)
# STREAM_BUFFER_SIZE=

# ========================================
# LOGGING (optional)
# ========================================
# Log Level (OPTIONAL - defaults to INFO)
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ========================================
# CLOUDFLARE D1 DATABASE (optional)
# ========================================
# Enable this to store server settings, playlists, and favorites in the cloud.
# Useful for ephemeral environments like Heroku. If left blank, local SQLite is used.
# CLOUDFLARE_D1_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_API_TOKEN=

# ========================================
# YOUTUBE BYPASS ARCHITECTURE (Highly Recommended)
# ========================================
# To bypass YouTube's datacenter blocks and age-restrictions (429 / Requested format not available):
# 
# 1. INSTALL THE PLUGIN:
# Run `pip install yt-dlp-getpot-wpc` in the same Python environment that your yt-dlp binary is located.
# 
# 2. FROZEN COOKIES:
# Export cookies from a newly-opened Incognito window (immediately after logging in) using a browser extension.
# Save it as `cookies.txt` or `youtube-cookies.txt` in the root folder of this bot.
# 
# 3. YOUTUBE_COOKIES (For Heroku/Docker/Custom Paths):
# If you cannot save a file to the root directory, you can set this variable. It intelligently accepts:
# - A relative or absolute path to a cookie file (e.g., ./scratch/cookies.txt or /home/bot/cookies.txt)
# - A raw Base64 encoded string of your cookie file content (Crucial for Heroku deployments)
# YOUTUBE_COOKIES=

# 4. PROXY (For Hard IP Blocks):
# If your server's IP address is completely banned by YouTube (common in cheap datacenters),
# you can optionally route yt-dlp traffic through a SOCKS5/HTTP proxy here:
# YOUTUBE_PROXY=

# 5. USER-AGENT (To Match Frozen Cookies):
# YouTube sometimes checks if the User-Agent requesting the stream matches the User-Agent that originally generated the cookies.
# Paste the exact User-Agent string from the browser you used to extract the cookies.
# YOUTUBE_USER_AGENT=
