# Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications
BOT_TOKEN=

# Your Discord User ID (REQUIRED)
# Enable Developer Mode in Discord settings, then right-click your profile -> Copy ID
BOT_OWNER_ID=

# DJ Role ID (OPTIONAL)
# Users with this role can force-skip songs. Leave empty to disable.
DJ_ROLE_ID=

# Spotify API Credentials (REQUIRED for Spotify support)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify Refresh Token (OPTIONAL - for extended API access)
# Only needed if you hit rate limits. See play-dl docs for setup.
SPOTIFY_REFRESH_TOKEN=

# Spotify Market (OPTIONAL - defaults to US)
# Set to your country code for better regional results
SPOTIFY_MARKET=US

# YouTube Cookie (RECOMMENDED - fixes "Invalid URL" errors)
# Without this, YouTube may block streaming requests.
# How to get your cookie:
# 1. Open YouTube in Chrome/Firefox while logged in
# 2. Press F12 → Network tab → refresh page
# 3. Click any request to youtube.com → Headers tab
# 4. Copy the entire "Cookie:" header value
# Or use a browser extension like "Get cookies.txt" / "EditThisCookie"
YOUTUBE_COOKIE=

# Log Level (OPTIONAL - defaults to INFO)
# Options: DEBUG, INFO, WARN, ERROR
# DEBUG shows all logs including URL normalization, stream creation, etc.
LOG_LEVEL=INFO
