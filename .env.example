# Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications
BOT_TOKEN=

# Your Discord User ID (REQUIRED)
# Enable Developer Mode in Discord settings, then right-click your profile -> Copy ID
BOT_OWNER_ID=

# DJ Role ID (OPTIONAL)
# Users with this role can force-skip songs and use admin commands. Leave empty to disable.
DJ_ROLE_ID=

# Spotify API Credentials (REQUIRED for Spotify support)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify Market (OPTIONAL - defaults to US)
# Set to your country code for better regional results
SPOTIFY_MARKET=US

# YouTube Cookies (OPTIONAL - for age-restricted videos)
# Create youtube-cookies.txt in project root with your YouTube cookie string
# To get cookies:
#   1. Open incognito window, log into YouTube
#   2. Open DevTools (F12) -> Network tab
#   3. Copy the Cookie header value from any youtube.com request
#   4. Paste into youtube-cookies.txt
# Note: youtube-cookies.json format is also supported for backwards compatibility

# Log Level (OPTIONAL - defaults to INFO)
# Options: DEBUG, INFO, WARN, ERROR
# DEBUG shows all logs including URL detection, stream events, etc.
LOG_LEVEL=INFO
