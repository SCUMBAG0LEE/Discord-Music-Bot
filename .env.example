# Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications
BOT_TOKEN=

# Bot Client ID (REQUIRED for slash commands registration)
# Get from: Discord Developer Portal -> Your App -> General Information -> Application ID
CLIENT_ID=

# Guild ID (OPTIONAL)
# For testing - registers commands instantly in this server
# Leave empty to register globally (takes up to 1 hour)
GUILD_ID=

# Bot Owner ID (REQUIRED for owner commands)
# Your Discord user ID - grants access to owner-only commands
# Get your ID: Enable Developer Mode in Discord, right-click yourself, Copy ID
OWNER_ID=

# DJ Role ID (OPTIONAL)
# Users with this role can force-skip, clear queue, etc.
# Leave empty to allow everyone to use DJ commands
DJ_ROLE_ID=

# Lavalink Server Configuration (REQUIRED)
# Host format: hostname:port (e.g., localhost:2333)
LAVALINK_HOST=localhost:2333
LAVALINK_PASSWORD=youshallnotpass
# Set to 'true' if using wss:// (secure WebSocket)
LAVALINK_SECURE=false

# ===========================================
# Bot Settings (OPTIONAL - defaults shown)
# ===========================================

# Default playback volume (0-150)
DEFAULT_VOLUME=100

# Max queue size (0 = unlimited)
MAX_QUEUE_SIZE=0

# Max song duration in seconds (0 = unlimited)
# e.g., 600 = 10 minutes max per song
MAX_DURATION=0

# Skip ratio for vote skip (0.0-1.0)
# 0.5 = 50% of listeners needed to skip
SKIP_RATIO=0.5

# ===========================================
# Bot Activity/Status (OPTIONAL)
# ===========================================

# Activity type: PLAYING, LISTENING, WATCHING, COMPETING
BOT_ACTIVITY_TYPE=LISTENING

# Activity text shown in Discord
BOT_ACTIVITY_NAME=music | /help

# Online status: online, idle, dnd, invisible
BOT_STATUS=online

# ===========================================
# Auto-disconnect Settings (OPTIONAL)
# ===========================================

# Bot leaves when alone in VC after this many seconds (0 = disabled)
ALONE_TIME=60

# Bot leaves when idle (not playing) after this many seconds (0 = disabled)
IDLE_TIME=120

# Set to 'true' to keep bot in voice channel 24/7 (overrides timeouts)
# This is the global setting - can also be toggled per-server with /settings 247
STAY_IN_CHANNEL=false

# ===========================================
# Now Playing Display (OPTIONAL)
# ===========================================

# Show thumbnail images in now playing embeds
NP_IMAGES=true
