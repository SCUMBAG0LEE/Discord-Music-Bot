{
  "name": "discord-music-bot",
  "version": "5.4.0",
  "type": "module",
  "description": "A feature-rich, high-performance Discord music bot using Seyfert + yt-dlp",
  "main": "src/index.js",
  "scripts": {
    "start": "bun src/index.js",
    "dev": "bun --watch src/index.js",
    "debug": "LOG_LEVEL=DEBUG bun src/index.js"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "latest",
    "@snazzah/davey": "latest",
    "ffmpeg-static": "latest",
    "seyfert": "latest",
    "sodium-native": "latest"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "youtube",
    "spotify",
    "yt-dlp",
    "seyfert"
  ],
  "license": "MIT"
}
